<launch>
  <arg name="gui" default="true" />

  <!-- the video in a loop, on camera/image_raw and camera/camera_info -->
  <node name="camera" pkg="image_publisher" type="image_publisher" args="$(find opencv_apps)/test/codes.mp4" >
    <param name="publish_rate" value="10" />
  </node>

  <!-- aruco_detection_nodelet.cpp, downloads the models at the first time -->
  <include file="$(find opencv_apps)/launch/aruco_detection.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="camera/image_raw" />
    <arg name="use_camera_info" value="true" />
    <arg name="marker_length" value="0.05" />
  </include>

  <param name="aruco_detection_detections_test/topic" value="aruco_detection/detections" />
  <test test-name="aruco_detection_detections_test" pkg="rostest" type="hztest" name="aruco_detection_detections_test" time-limit="300" >
    <param name="hz" value="10" />
    <param name="hzerror" value="8" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
  <param name="aruco_detection_poses_test/topic" value="aruco_detection/poses" />
  <test test-name="aruco_detection_poses_test" pkg="rostest" type="hztest" name="aruco_detection_poses_test" time-limit="300" >
    <param name="hz" value="10" />
    <param name="hzerror" value="8" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
  <param name="aruco_detection_image_test/topic" value="aruco_detection/image" />
  <test test-name="aruco_detection_image_test" pkg="rostest" type="hztest" name="aruco_detection_image_test" time-limit="300" >
    <param name="hz" value="10" />
    <param name="hzerror" value="8" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
