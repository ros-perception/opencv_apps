<launch>
  <arg name="gui" default="true" />

  <!-- the video in a loop, on camera/image_raw and camera/camera_info -->
  <node name="camera" pkg="image_publisher" type="image_publisher" args="$(find opencv_apps)/test/face_detector_withface_test_diamondback.mp4" >
    <param name="publish_rate" value="10" />
  </node>

  <!-- dnn_inpainting_nodelet.cpp, downloads the model at the first time, needs OpenCV 5.0 or later -->
  <include file="$(find opencv_apps)/launch/dnn_inpainting.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="camera/image_raw" />
  </include>
  <!-- fill the face of the person sitting at the center -->
  <node name="dnn_inpainting_set_roi" pkg="opencv_apps" type="set_image.py" args="377 211 50 50" >
    <remap from="set_roi" to="dnn_inpainting/set_roi" />
  </node>

  <param name="dnn_inpainting_image_test/topic" value="dnn_inpainting/image" />
  <test test-name="dnn_inpainting_image_test" pkg="rostest" type="hztest" name="dnn_inpainting_image_test" time-limit="300" >
    <param name="hz" value="9.0" />
    <param name="hzerror" value="8.9" />
    <param name="test_duration" value="10.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
