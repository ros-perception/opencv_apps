<launch>
  <arg name="gui" default="true" />

  <!-- the video in a loop, on camera/image_raw and camera/camera_info -->
  <node name="camera" pkg="image_publisher" type="image_publisher" args="$(find opencv_apps)/test/text.mp4" >
    <param name="publish_rate" value="10" />
  </node>

  <!-- dnn_text_detection_nodelet.cpp, downloads the models at the first time -->
  <include file="$(find opencv_apps)/launch/dnn_text_detection.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="camera/image_raw" />
  </include>

  <!-- DB (ResNet-18, 736x736) runs at about 1 Hz on the CPU of CI, and up to 10 Hz of the camera on others -->
  <param name="dnn_text_detection_detections_test/topic" value="dnn_text_detection/detections" />
  <test test-name="dnn_text_detection_detections_test" pkg="rostest" type="hztest" name="dnn_text_detection_detections_test" time-limit="300" >
    <param name="hz" value="5.5" />
    <param name="hzerror" value="5.4" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
  <param name="dnn_text_detection_image_test/topic" value="dnn_text_detection/image" />
  <test test-name="dnn_text_detection_image_test" pkg="rostest" type="hztest" name="dnn_text_detection_image_test" time-limit="300" >
    <param name="hz" value="5.5" />
    <param name="hzerror" value="5.4" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
