<launch>
  <arg name="gui" default="true" />
  <param name="use_sim_time" value="true" />
  <node name="play_vslam_bag" pkg="rosbag" type="play" args="-l $(find opencv_apps)/test/vslam_tutorial.bag -s 5 -r 0.2 --topics /narrow_stereo/left/image_rect /clock" />

  <group ns="narrow_stereo/left" >
    <node name="image_view" pkg="image_view" type="image_view" args="image:=image_rect" if="$(arg gui)" />

    <!-- line_segment_detector.cpp -->
    <include file="$(find opencv_apps)/launch/line_segment_detector.launch" >
      <arg name="debug_view" value="$(arg gui)" />
      <arg name="image" value="image_rect" />
      <arg name="lsd_refine_type" value="2" />
      <arg name="lsd_scale" value="0.4" />
      <arg name="lsd_density_threshold" value="0.3" />
      <arg name="lsd_line_length_threshold" value="10.0" />
    </include>

    <!-- Test Codes -->
    <node name="line_segment_detector_saver" pkg="image_view" type="image_saver" >
      <param name="filename_format" value="$(find opencv_apps)/test/line_segment_detector.png"/>
      <param name="queue_size" value="5" />
      <remap from="image" to="line_segment_detector/image" />
      <remap from="line_segment_detector/camera_info" to="camera_info" />
    </node>
    <param name="line_segment_detector_test/topic" value="line_segment_detector/lines" />    <!-- opencv_apps/LineArrayStamped -->
    <test test-name="line_segment_detector_test" pkg="rostest" type="hztest" name="line_segment_detector_test" >
      <param name="hz" value="30" />
      <param name="hzerror" value="10.0" />
      <param name="test_duration" value="1.0" />
    </test>
  </group>
</launch>
