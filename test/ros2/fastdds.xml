<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile of the ROS2 tests, set by opencv_apps_test.py: the shared memory transport with segments large
  enough for the images. With the default segment (512 KB), the images go through UDP in fragments, and the nodes,
  which subscribe the images with the best effort (sensor data) QoS, lose most of them on a slow machine, e.g. the
  2 core CI runners, so the chains of the nodes (e.g. pyramids and adding_images) publish nothing.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_transport</transport_id>
      <type>SHM</type>
      <segment_size>8388608</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="participant_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_transport</transport_id>
        <transport_id>udp_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
