<launch>
  <arg name="gui" default="true" />

  <!-- the video in a loop, on camera/image_raw and camera/camera_info -->
  <node name="camera" pkg="image_publisher" type="image_publisher" args="$(find opencv_apps)/test/face_detector_withface_test_diamondback.mp4" >
    <param name="publish_rate" value="10" />
  </node>

  <!-- dnn_interactive_segmentation_nodelet.cpp, downloads the model at the first time -->
  <include file="$(find opencv_apps)/launch/dnn_interactive_segmentation.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="camera/image_raw" />
  </include>
  <!-- segment the woman standing at the center -->
  <node name="dnn_interactive_segmentation_set_roi" pkg="opencv_apps" type="set_image.py" args="375 325 150 310" >
    <remap from="set_roi" to="dnn_interactive_segmentation/set_roi" />
  </node>

  <param name="dnn_interactive_segmentation_mask_test/topic" value="dnn_interactive_segmentation/mask" />
  <test test-name="dnn_interactive_segmentation_mask_test" pkg="rostest" type="hztest" name="dnn_interactive_segmentation_mask_test" time-limit="300" >
    <param name="hz" value="9.0" />
    <param name="hzerror" value="8.9" />
    <param name="test_duration" value="10.0" />
    <param name="wait_time" value="240.0" />
  </test>
  <param name="dnn_interactive_segmentation_image_test/topic" value="dnn_interactive_segmentation/image" />
  <test test-name="dnn_interactive_segmentation_image_test" pkg="rostest" type="hztest" name="dnn_interactive_segmentation_image_test" time-limit="300" >
    <param name="hz" value="9.0" />
    <param name="hzerror" value="8.9" />
    <param name="test_duration" value="10.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
