<launch>
  <arg name="gui" default="true" />
  <node name="play_face_bag" pkg="rosbag" type="play" args="-l $(find opencv_apps)/test/face_detector_withface_test_diamondback.bag" />

  <group ns="wide_stereo/left" >
    <node name="image_proc" pkg="image_proc" type="image_proc" />
    <node name="image_view" pkg="image_view" type="image_view" args="image:=image_color" if="$(arg gui)" />

    <!-- match_template_nodelet.cpp, the template is the face at the center of the first frame of image_color -->
    <include file="$(find opencv_apps)/launch/match_template.launch" >
      <arg name="debug_view" value="$(arg gui)" />
      <arg name="image" value="image_color" />
      <arg name="template_file" value="$(find opencv_apps)/test/match_template_face.png" />
    </include>
    <include file="$(find opencv_apps)/launch/match_template.launch" >
      <arg name="debug_view" value="$(arg gui)" />
      <arg name="image" value="image_color" />
      <arg name="template_file" value="$(find opencv_apps)/test/match_template_face.png" />
      <arg name="match_method" value="1" />
      <arg name="match_threshold" value="0.9" />
      <arg name="max_matches" value="5" />
      <arg name="node_name" value="match_template_sqdiff" />
    </include>

    <!-- Test Codes -->
    <node name="match_template_saver" pkg="image_view" type="image_saver" >
      <param name="filename_format" value="$(find opencv_apps)/test/match_template.png"/>
      <param name="queue_size" value="5" />
      <remap from="image" to="match_template/image" />
      <remap from="match_template/camera_info" to="camera_info" />
    </node>
    <param name="match_template_test/topic" value="match_template/image" />
    <test test-name="match_template_test" pkg="rostest" type="hztest" name="match_template_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
    <param name="match_template_matched_image_test/topic" value="match_template/matched_image" />
    <test test-name="match_template_matched_image_test" pkg="rostest" type="hztest" name="match_template_matched_image_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
    <param name="match_template_output_test/topic" value="match_template/output" />
    <test test-name="match_template_output_test" pkg="rostest" type="hztest" name="match_template_output_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
    <param name="match_template_score_test/topic" value="match_template/score" />
    <test test-name="match_template_score_test" pkg="rostest" type="hztest" name="match_template_score_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
    <param name="match_template_sqdiff_test/topic" value="match_template_sqdiff/image" />
    <test test-name="match_template_sqdiff_test" pkg="rostest" type="hztest" name="match_template_sqdiff_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
    <param name="match_template_sqdiff_output_test/topic" value="match_template_sqdiff/output" />
    <test test-name="match_template_sqdiff_output_test" pkg="rostest" type="hztest" name="match_template_sqdiff_output_test" >
      <param name="hz" value="20" />
      <param name="hzerror" value="15" />
      <param name="test_duration" value="5.0" />
    </test>
  </group>
</launch>
