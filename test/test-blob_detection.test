<launch>
  <arg name="gui" default="true" />
  <param name="use_sim_time" value="true" />
  <node name="play_face_bag" pkg="rosbag" type="play" args="-l $(find opencv_apps)/test/face_detector_withface_test_diamondback.bag --clock -r 0.1" />

  <group ns="wide_stereo/left" >
    <node name="image_proc" pkg="image_proc" type="image_proc" />
    <node name="image_view" pkg="image_view" type="image_view" args="image:=image_rect_color" if="$(arg gui)" />

    <!-- color_filter.cpp : binary mask of the skin color -->
    <include file="$(find opencv_apps)/launch/hsv_color_filter.launch" >
      <arg name="debug_view" value="$(arg gui)" />
      <arg name="image" value="image_rect_color" />
      <arg name="h_limit_max" value="40" />
      <arg name="h_limit_min" value="0" />
      <arg name="s_limit_max" value="160" />
      <arg name="s_limit_min" value="60" />
      <arg name="v_limit_max" value="255" />
      <arg name="v_limit_min" value="100" />
    </include>

    <!-- blob_detection.cpp -->
    <include file="$(find opencv_apps)/launch/blob_detection.launch" >
      <arg name="debug_view" value="$(arg gui)" />
      <arg name="image" value="hsv_color_filter/image" />
      <arg name="min_area" value="100.0" />
    </include>

    <!-- Test Codes -->
    <node name="blob_detection_saver" pkg="image_view" type="image_saver" >
      <param name="filename_format" value="$(find opencv_apps)/test/blob_detection.png"/>
      <param name="queue_size" value="5" />
      <remap from="image" to="blob_detection/image" />
      <remap from="blob_detection/camera_info" to="camera_info" />
    </node>
    <param name="blob_detection_test/topic" value="blob_detection/circles" />    <!-- opencv_apps/CircleArrayStamped -->
    <test test-name="blob_detection_test" pkg="rostest" type="hztest" name="blob_detection_test" >
      <param name="hz" value="30" />
      <param name="hzerror" value="10.0" />
      <param name="test_duration" value="1.0" />
    </test>
  </group>
</launch>
