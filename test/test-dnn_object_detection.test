<launch>
  <arg name="gui" default="true" />

  <!-- the video in a loop, on camera/image_raw and camera/camera_info -->
  <node name="camera" pkg="image_publisher" type="image_publisher" args="$(find opencv_apps)/test/face_detector_withface_test_diamondback.mp4" >
    <param name="publish_rate" value="10" />
  </node>

  <!-- dnn_object_detection_nodelet.cpp, downloads the models at the first time -->
  <include file="$(find opencv_apps)/launch/dnn_object_detection.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="camera/image_raw" />
  </include>

  <param name="dnn_object_detection_detections_test/topic" value="dnn_object_detection/detections" />
  <test test-name="dnn_object_detection_detections_test" pkg="rostest" type="hztest" name="dnn_object_detection_detections_test" time-limit="300" >
    <param name="hz" value="10" />
    <param name="hzerror" value="8" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
  <param name="dnn_object_detection_image_test/topic" value="dnn_object_detection/image" />
  <test test-name="dnn_object_detection_image_test" pkg="rostest" type="hztest" name="dnn_object_detection_image_test" time-limit="300" >
    <param name="hz" value="10" />
    <param name="hzerror" value="8" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
