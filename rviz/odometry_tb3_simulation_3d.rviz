# rviz2 of launch/odometry_tb3_simulation.launch.py, 3D: the 3D map of rgbd_odometry (colored by the height), the
# 2D map of laser_odometry (white), the trajectories of laser_odometry (yellow) and rgbd_odometry (cyan) and the
# robot, in map;
#   ros2 run rviz2 rviz2 -d $(ros2 pkg prefix --share opencv_apps)/rviz/odometry_tb3_simulation_3d.rviz
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: rgbd_odometry/map
      Color Transformer: AxisColor
      Color: 255; 255; 255
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: 0.0
      Max Value: 0.5
      Alpha: 1.0
      Decay Time: 0
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rgbd_odometry/map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: laser_odometry/map
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: 0.0
      Max Value: 0.5
      Alpha: 0.5
      Decay Time: 0
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /laser_odometry/map
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: laser_odometry/path
      Color: 255; 220; 0
      Line Style: Billboards
      Line Width: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /laser_odometry/path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: rgbd_odometry/path
      Color: 0; 220; 255
      Line Style: Billboards
      Line Width: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rgbd_odometry/path
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0.5
        Y: 0.5
        Z: 0
      Name: Current View
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 2.5
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1280
