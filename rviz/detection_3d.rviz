# rviz2 of detection_3d: the 3D boxes and the labels of ~/markers, the TF frames of the objects (the axes of
# ~/markers; the TF display, off, shows all the frames), the points of the depth, the 2D detections and the depth
# image, in camera_link (x forward, z up) of test/publish_rgbd.py and test/publish_lidar.py;
#   ros2 run rviz2 rviz2 -d $(ros2 pkg prefix --share opencv_apps)/rviz/detection_3d.rviz
# give -f <frame> for the frame of your camera, e.g. -f camera_link of realsense2_camera.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Marker Scale: 0.5
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: detection_3d/markers
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /detection_3d/markers
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: points
      Color Transformer: RGB8
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: dnn_object_detection/image
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dnn_object_detection/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: depth
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depth
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 2.2
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.3
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1280
  dnn_object_detection/image:
    collapsed: false
