# rviz2 of laser_odometry: the 3D map (~/map, colored by the height), the points of the LiDAR, the trajectory
# (~/path) and the pose (~/odom) of the robot, in odom (z up with base_frame of the robot);
#   ros2 run rviz2 rviz2 -d $(ros2 pkg prefix --share opencv_apps)/rviz/laser_odometry.rviz
# give the topic of your LiDAR by remapping, e.g. --ros-args -r /points:=/livox/lidar.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: laser_odometry/map
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: -1.5
      Max Value: 1.5
      Alpha: 0.3
      Decay Time: 0
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /laser_odometry/map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: points
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Axis: Z
      Decay Time: 0
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: laser_odometry/path
      Color: 255; 220; 0
      Line Style: Billboards
      Line Width: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /laser_odometry/path
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: laser_odometry/odom
      Keep: 1
      Shape:
        Value: Axes
        Axes Length: 0.5
        Axes Radius: 0.05
      Covariance:
        Value: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /laser_odometry/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1280
