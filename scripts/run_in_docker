#!/bin/bash
# Run a node of opencv_apps in a docker image of OpenCV with CUDA (docker/cuda, docker/opencv5-cuda), e.g. as the
# launch-prefix of use_cuda:=true of the launch files of the dnn nodes:
#   run_in_docker IMAGE EXECUTABLE [ARGUMENTS...]
# EXECUTABLE (of the host) runs as the executable of the same name of opencv_apps in IMAGE, with the GPUs, the network,
# the IPC (the shared memory of DDS) and the processes of the host, as the user of the host, with the ROS environment
# of the host (ROS_DOMAIN_ID, RMW_IMPLEMENTATION, ...), ~/.ros (the downloaded models) and /tmp (the parameters of
# launch). IMAGE is pulled if it is not on the host, e.g. ghcr.io/ros-perception/opencv_apps:cuda (docker pull
# ghcr.io/ros-perception/opencv_apps:cuda), or built from docker/ of opencv_apps, e.g.
# docker build -f docker/cuda/Dockerfile -t opencv_apps:cuda .
set -e
if [ $# -lt 2 ]; then
  echo "usage: $0 IMAGE EXECUTABLE [ARGUMENTS...]" >&2
  exit 2
fi
image=$1
executable=$(basename "$2")
shift 2
if ! docker image inspect "$image" > /dev/null 2>&1; then
  # the first use: the image of OpenCV with CUDA is about 10 GB
  echo "$0: pulling the docker image $image" >&2
  if ! docker pull "$image" >&2; then
    echo "$0: failed to pull the docker image $image; pull it by" >&2
    echo "  docker pull $image" >&2
    echo "checking the name and the tag of the image (the tags of ghcr.io/ros-perception/opencv_apps are cuda" \
         "and opencv5-cuda), the network, and the login of docker (docker login ghcr.io, when it is denied)" >&2
    exit 1
  fi
fi
environment=()
for name in ROS_DOMAIN_ID ROS_LOCALHOST_ONLY ROS_AUTOMATIC_DISCOVERY_RANGE ROS_STATIC_PEERS RMW_IMPLEMENTATION \
            FASTDDS_DEFAULT_PROFILES_FILE FASTRTPS_DEFAULT_PROFILES_FILE CYCLONEDDS_URI RCUTILS_LOGGING_BUFFERED_STREAM \
            RCUTILS_COLORIZED_OUTPUT DISPLAY; do
  [ -n "${!name}" ] && environment+=(-e "$name=${!name}")
done
mkdir -p "$HOME/.ros"
# the X server of the host for debug_view (/tmp/.X11-unix is in /tmp)
xauthority=${XAUTHORITY:-$HOME/.Xauthority}
[ -f "$xauthority" ] && environment+=(-e "XAUTHORITY=$xauthority" -v "$xauthority:$xauthority:ro")
# the node of the ROS distribution of the image, which receives SIGINT and SIGTERM of launch by docker run
exec docker run --rm --init --gpus all --net=host --ipc=host --pid=host \
  --user "$(id -u):$(id -g)" -e HOME="$HOME" -v "$HOME/.ros:$HOME/.ros" -v /tmp:/tmp "${environment[@]}" \
  "$image" bash -c '. /opt/ros/*/setup.sh && . /ws/install/setup.sh && exec /ws/install/opencv_apps/lib/opencv_apps/"$0" "$@"' \
  "$executable" "$@"
