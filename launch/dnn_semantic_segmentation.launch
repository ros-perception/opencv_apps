<launch>
  <arg name="node_name" default="dnn_semantic_segmentation" />

  <arg name="image" default="image" doc="The image topic. Should be remapped to the name of the real image topic." />

  <arg name="use_camera_info" default="false" doc="Indicates that the camera_info topic should be subscribed to to get the default input_frame_id. Otherwise the frame from the image message will be used." />
  <arg name="debug_view" default="true" doc="Specify whether the node displays a window to show the result" />
  <arg name="queue_size" default="3" doc="Specify queue_size of input image subscribers" />
  <arg name="model" default="" doc="Path or URL of the model whose output is the scores of the classes for each pixel, empty for PP-HumanSeg of opencv_zoo" />
  <arg name="classes" default="" doc="Path or URL of the class names of the model, one name per line, the first one is the background, or empty for background and person of PP-HumanSeg" />
  <arg name="backend" default="auto" doc="Backend of cv::dnn: auto, cpu, opencl, opencl_fp16, cuda or cuda_fp16. auto uses CUDA when OpenCV is built with CUDA and a CUDA device is found, and the CPU otherwise." />
  <arg name="input_width" default="192" doc="Width of the network input" />
  <arg name="input_height" default="192" doc="Height of the network input" />
  <arg name="scale" default="0.00784313725490196" doc="Multiplier of the pixel values for the network input" />
  <arg name="mean" default="127.5" doc="Mean subtracted from the pixel values before the scale" />
  <arg name="swap_rb" default="true" doc="Swap the red and blue channels, true for the models trained in RGB" />

  <!-- dnn_semantic_segmentation_nodelet.cpp, DNN semantic segmentation, PP-HumanSeg (persons) by default -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="dnn_semantic_segmentation" >
    <remap from="image" to="$(arg image)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="debug_view" value="$(arg debug_view)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="model" type="str" value="$(arg model)" />
    <param name="classes" type="str" value="$(arg classes)" />
    <param name="backend" type="str" value="$(arg backend)" />
    <param name="input_width" value="$(arg input_width)" />
    <param name="input_height" value="$(arg input_height)" />
    <param name="scale" type="double" value="$(arg scale)" />
    <param name="mean" type="double" value="$(arg mean)" />
    <param name="swap_rb" value="$(arg swap_rb)" />
  </node>
</launch>
