<launch>
  <arg name="node_name" default="dnn_object_detection" />

  <arg name="image" default="image" doc="The image topic. Should be remapped to the name of the real image topic." />

  <arg name="use_camera_info" default="false" doc="Indicates that the camera_info topic should be subscribed to to get the default input_frame_id. Otherwise the frame from the image message will be used." />
  <arg name="debug_view" default="true" doc="Specify whether the node displays a window to show the result" />
  <arg name="queue_size" default="3" doc="Specify queue_size of input image subscribers" />
  <arg name="model" default="" doc="Path or URL of the model (e.g. .weights, .onnx), empty for YOLOv4-tiny trained on COCO" />
  <arg name="config" default="" doc="Path or URL of the network configuration (e.g. .cfg) of the model, or empty" />
  <arg name="classes" default="" doc="Path or URL of the class names, one name per line, or empty" />
  <arg name="backend" default="auto" doc="Backend of cv::dnn: auto, cpu, opencl, opencl_fp16, cuda or cuda_fp16. auto uses CUDA when OpenCV is built with CUDA and a CUDA device is found, and the CPU otherwise." />
  <arg name="input_width" default="416" doc="Width of the network input" />
  <arg name="input_height" default="416" doc="Height of the network input" />
  <arg name="scale" default="0.00392156862745098" doc="Multiplier of the pixel values for the network input" />
  <arg name="swap_rb" default="true" doc="Swap the red and blue channels, true for the models trained in RGB" />
  <arg name="confidence_threshold" default="0.5" doc="Threshold of the confidence to detect the objects" />
  <arg name="nms_threshold" default="0.4" doc="Threshold of the overlap of the objects to suppress, by non maximum suppression" />

  <!-- dnn_object_detection_nodelet.cpp, DNN object detection, YOLOv4-tiny (COCO) by default -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="dnn_object_detection" >
    <remap from="image" to="$(arg image)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="debug_view" value="$(arg debug_view)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="model" value="$(arg model)" />
    <param name="config" value="$(arg config)" />
    <param name="classes" value="$(arg classes)" />
    <param name="backend" value="$(arg backend)" />
    <param name="input_width" value="$(arg input_width)" />
    <param name="input_height" value="$(arg input_height)" />
    <param name="scale" type="double" value="$(arg scale)" />
    <param name="swap_rb" value="$(arg swap_rb)" />
    <param name="confidence_threshold" type="double" value="$(arg confidence_threshold)" />
    <param name="nms_threshold" type="double" value="$(arg nms_threshold)" />
  </node>
</launch>
