<launch>
  <arg name="node_name" default="dnn_depth_estimation" />

  <arg name="image" default="image" doc="The image topic. Should be remapped to the name of the real image topic." />

  <arg name="use_camera_info" default="false" doc="Indicates that the camera_info topic should be subscribed to to get the default input_frame_id. Otherwise the frame from the image message will be used." />
  <arg name="debug_view" default="true" doc="Specify whether the node displays a window to show the result" />
  <arg name="queue_size" default="3" doc="Specify queue_size of input image subscribers" />
  <arg name="model" default="" doc="Path or URL of the model (onnx) of the same input and output as MiDaS, empty for MiDaS v2.1 small" />
  <arg name="backend" default="auto" doc="Backend of cv::dnn: auto, cpu, opencl, opencl_fp16, cuda or cuda_fp16. auto uses CUDA when OpenCV is built with CUDA and a CUDA device is found, and the CPU otherwise." />
  <arg name="input_width" default="256" doc="Width of the network input, 256 for MiDaS v2.1 small" />
  <arg name="input_height" default="256" doc="Height of the network input, 256 for MiDaS v2.1 small" />

  <!-- dnn_depth_estimation_nodelet.cpp, DNN monocular depth estimation, MiDaS v2.1 small by default -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="dnn_depth_estimation" >
    <remap from="image" to="$(arg image)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="debug_view" value="$(arg debug_view)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="model" type="str" value="$(arg model)" />
    <param name="backend" type="str" value="$(arg backend)" />
    <param name="input_width" value="$(arg input_width)" />
    <param name="input_height" value="$(arg input_height)" />
  </node>
</launch>
