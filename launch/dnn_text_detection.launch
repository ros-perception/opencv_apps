<launch>
  <arg name="node_name" default="dnn_text_detection" />

  <arg name="image" default="image" doc="The image topic. Should be remapped to the name of the real image topic." />

  <arg name="use_camera_info" default="false" doc="Indicates that the camera_info topic should be subscribed to to get the default input_frame_id. Otherwise the frame from the image message will be used." />
  <arg name="debug_view" default="true" doc="Specify whether the node displays a window to show the result" />
  <arg name="queue_size" default="3" doc="Specify queue_size of input image subscribers" />
  <arg name="detection_model" default="" doc="Path or URL of the text detection model of DB (onnx), empty for DB (ResNet-18, IC15) of opencv_zoo" />
  <arg name="recognition_model" default="" doc="Path or URL of the text recognition model of CRNN (onnx), empty for CRNN (English) of opencv_zoo, or none to detect the text only" />
  <arg name="vocabulary" default="" doc="Path or URL of the vocabulary of the recognition model, one character per line, or empty for 0-9 and a-z of CRNN (English)" />
  <arg name="backend" default="auto" doc="Backend of cv::dnn: auto, cpu, opencl, opencl_fp16, cuda or cuda_fp16. auto uses CUDA when OpenCV is built with CUDA and a CUDA device is found, and the CPU otherwise." />
  <arg name="input_width" default="736" doc="Width of the input of the detection model, a multiple of 32" />
  <arg name="input_height" default="736" doc="Height of the input of the detection model, a multiple of 32" />
  <arg name="binary_threshold" default="0.3" doc="Threshold of the text probability of the pixels" />
  <arg name="polygon_threshold" default="0.5" doc="Threshold of the score of the text regions" />
  <arg name="unclip_ratio" default="2.0" doc="Ratio to expand the detected text regions" />
  <arg name="max_candidates" default="200" doc="Maximum number of the text regions" />

  <!-- dnn_text_detection_nodelet.cpp, DNN text detection and recognition (OCR), DB and CRNN (English) by default -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="dnn_text_detection" >
    <remap from="image" to="$(arg image)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="debug_view" value="$(arg debug_view)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="detection_model" type="str" value="$(arg detection_model)" />
    <param name="recognition_model" type="str" value="$(arg recognition_model)" />
    <param name="vocabulary" type="str" value="$(arg vocabulary)" />
    <param name="backend" type="str" value="$(arg backend)" />
    <param name="input_width" value="$(arg input_width)" />
    <param name="input_height" value="$(arg input_height)" />
    <param name="binary_threshold" type="double" value="$(arg binary_threshold)" />
    <param name="polygon_threshold" type="double" value="$(arg polygon_threshold)" />
    <param name="unclip_ratio" type="double" value="$(arg unclip_ratio)" />
    <param name="max_candidates" value="$(arg max_candidates)" />
  </node>
</launch>
