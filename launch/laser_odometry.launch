<launch>
  <arg name="node_name" default="laser_odometry" />

  <arg name="points" default="points" doc="The point cloud of a 3D LiDAR (sensor_msgs/PointCloud2), e.g. /livox/lidar of livox_ros_driver2 (xfer_format 0)." />
  <arg name="scan" default="scan" doc="The scan of a 2D LiDAR (sensor_msgs/LaserScan), with input_type scan." />

  <arg name="input_type" default="points" doc="Type of input: points (PointCloud2 of a 3D LiDAR, e.g. Livox) or scan (LaserScan of a 2D LiDAR)." />
  <arg name="voxel_size" default="0.5" doc="Size (m) of the voxels of the map, e.g. 0.5 outdoors and 0.1 - 0.2 indoors." />
  <arg name="max_points_per_voxel" default="20" doc="Maximum points in a voxel of the map." />
  <arg name="min_range" default="0.3" doc="Minimum range (m) of the points, without the robot." />
  <arg name="max_range" default="50.0" doc="Maximum range (m) of the points, and of the map." />
  <arg name="max_iterations" default="50" doc="Maximum iterations of ICP of each scan." />
  <arg name="correspondence_distance" default="1.0" doc="Maximum distance (m) of the corresponding points of the scan and the map, larger than the error of the initial guess of the constant velocity." />
  <arg name="queue_size" default="10" doc="Queue size of the subscriber." />
  <arg name="odom_frame" default="odom" doc="Frame of the odometry, the robot (base_frame) at the start." />
  <arg name="base_frame" default="" doc="Frame of the robot, whose TF to the sensor is given (e.g. base_link, base_footprint), or empty for the frame of the sensor." />
  <arg name="publish_tf" default="true" doc="Publish the TF odom_frame -> base_frame; with it at the start, the node subscribes the inputs always, for the subscribers of /tf." />
  <arg name="path_length" default="10000" doc="Number of the poses of ~/path, the trajectory for rviz, 0 for all of them." />
  <arg name="map_voxel_size" default="0.05" doc="Size (m) of the voxels of the 3D map (~/map, a point of each voxel), 0 for no map." />
  <arg name="map_period" default="1.0" doc="Period (s) to publish the 3D map (~/map)." />

  <!-- laser_odometry_nodelet.cpp, the odometry of a LiDAR (e.g. Livox) by ICP of the scans to the local map -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="laser_odometry" >
    <remap from="points" to="$(arg points)" />
    <remap from="scan" to="$(arg scan)" />
    <param name="input_type" type="str" value="$(arg input_type)" />
    <param name="voxel_size" value="$(arg voxel_size)" />
    <param name="max_points_per_voxel" value="$(arg max_points_per_voxel)" />
    <param name="min_range" value="$(arg min_range)" />
    <param name="max_range" value="$(arg max_range)" />
    <param name="max_iterations" value="$(arg max_iterations)" />
    <param name="correspondence_distance" value="$(arg correspondence_distance)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="odom_frame" type="str" value="$(arg odom_frame)" />
    <param name="base_frame" type="str" value="$(arg base_frame)" />
    <param name="publish_tf" value="$(arg publish_tf)" />
    <param name="path_length" value="$(arg path_length)" />
    <param name="map_voxel_size" value="$(arg map_voxel_size)" />
    <param name="map_period" value="$(arg map_period)" />
  </node>
</launch>
