<launch>
  <arg name="node_name" default="dnn_inpainting" />

  <arg name="image" default="image" doc="The image topic. Should be remapped to the name of the real image topic." />
  <arg name="mask" default="mask" doc="The mask image topic (mono8), the non-zero pixels of the latest mask are filled, e.g. ~/label of dnn_semantic_segmentation" />

  <arg name="use_camera_info" default="false" doc="Indicates that the camera_info topic should be subscribed to to get the default input_frame_id. Otherwise the frame from the image message will be used." />
  <arg name="debug_view" default="true" doc="Specify whether the node displays a window to show the result" />
  <arg name="queue_size" default="3" doc="Specify queue_size of input image subscribers" />
  <arg name="model" default="" doc="Path or URL of the model (onnx) of the same input and output as LaMa, empty for LaMa of opencv_zoo" />
  <arg name="backend" default="cpu" doc="Backend of cv::dnn: auto, cpu, opencl, opencl_fp16, cuda or cuda_fp16. auto uses CUDA when OpenCV is built with CUDA and a CUDA device is found, and the CPU otherwise. cpu by default, as OpenCV 5.1 runs LaMa on the CPU also with cuda, which is slower" />

  <!-- dnn_inpainting_nodelet.cpp, DNN inpainting of the rect of ~set_roi and the mask, LaMa (OpenCV 5.0 or later) -->
  <node name="$(arg node_name)" pkg="opencv_apps" type="dnn_inpainting" >
    <remap from="image" to="$(arg image)" />
    <remap from="mask" to="$(arg mask)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="debug_view" value="$(arg debug_view)" />
    <param name="queue_size" value="$(arg queue_size)" />
    <param name="model" type="str" value="$(arg model)" />
    <param name="backend" type="str" value="$(arg backend)" />
  </node>
</launch>
